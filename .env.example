# ==================================================
# ROVEI — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development.
# NEVER commit real secrets.
# ==================================================

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Legacy fallback only if your Supabase project uses the older key type
SUPABASE_SERVICE_ROLE_KEY=

# Paddle — later phase
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Email — later phase
RESEND_API_KEY=

# Monitoring — later phase
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ElevenLabs — later phase
ELEVENLABS_API_KEY=

# Telephony — provider chosen later
TELEPHONY_PROVIDER=
TELNYX_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
