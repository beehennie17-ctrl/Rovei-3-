diff --git a/lib/backend/locked-studio-state.ts b/lib/backend/locked-studio-state.ts
new file mode 100644
index 0000000..4d45479
--- /dev/null
+++ b/lib/backend/locked-studio-state.ts
@@ -0,0 +1,74 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+
+type ClientRow = { id: string; first_name: string; last_name: string | null; created_at: string };
+type AppointmentRow = { id: string; client_id: string; service_id: string | null; starts_at: string; timezone: string; status: string; readiness_status: string };
+type ExperienceRow = { id: string; client_id: string; experience_modules: unknown; created_at: string };
+type ResponseRow = { client_experience_id: string; module_type: string; payload: Record<string, unknown> };
+type PackRow = { id: string; name: string; service_category: string };
+type ModuleRow = { beauty_pack_id: string; module_type: string; sort_order: number };
+type VisitRow = { id: string; client_id: string; summary: string | null; created_at: string };
+export type LockedStudioRows = {
+  clients: ClientRow[]; appointments: AppointmentRow[]; experiences: ExperienceRow[];
+  responses: ResponseRow[]; packs: PackRow[]; modules: ModuleRow[]; visits: VisitRow[];
+  services: { id: string; category: string | null }[];
+};
+
+function localParts(value: string, timezone: string) {
+  const parts = new Intl.DateTimeFormat("en-CA", {
+    timeZone: timezone, year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
+  }).formatToParts(new Date(value));
+  const part = (name: string) => parts.find((p) => p.type === name)?.value ?? "";
+  return { date: `${part("year")}-${part("month")}-${part("day")}`, time: `${part("hour")}:${part("minute")}` };
+}
+
+export function adaptLockedStudioRows(rows: LockedStudioRows, now = Date.now()) {
+  return {
+    clients: rows.clients.map((client) => {
+      const appointments = rows.appointments.filter((a) => a.client_id === client.id && a.status !== "cancelled").sort((a,b)=>Date.parse(a.starts_at)-Date.parse(b.starts_at));
+      const appointment = appointments.find((a) => a.status === "scheduled" && Date.parse(a.starts_at) >= now) ?? appointments.at(-1);
+      const experience = rows.experiences.filter((e) => e.client_id === client.id).sort((a,b)=>Date.parse(b.created_at)-Date.parse(a.created_at))[0];
+      const answers = Object.fromEntries(rows.responses.filter((r)=>r.client_experience_id===experience?.id).map((r)=>[r.module_type,r.payload]));
+      const local = appointment ? localParts(appointment.starts_at,appointment.timezone || "UTC") : {date:"",time:""};
+      return {
+        id:client.id, firstName:client.first_name, lastName:client.last_name ?? "",
+        service:rows.services.find((s)=>s.id===appointment?.service_id)?.category ?? "other",
+        appointmentId:appointment?.id ?? null, appointmentDate:local.date, appointmentTime:local.time,
+        status:appointment?.status === "completed" ? "COMPLETE" : (appointment?.readiness_status ?? "draft").toUpperCase(),
+        modules:Array.isArray(experience?.experience_modules) ? experience.experience_modules : [],
+        response:{consultation:answers.consultation?.goal ?? "",finish:answers.preferences?.finish ?? "",feel:answers.preferences?.appointmentFeel ?? "",consent:answers.consent?.acknowledged === true,prep:answers.prep?.acknowledged === true},
+        source:"client-record",createdAt:client.created_at,
+      };
+    }),
+    beautyPacks:rows.packs.map((p)=>({id:p.id,name:p.name,service:p.service_category,modules:rows.modules.filter((m)=>m.beauty_pack_id===p.id).sort((a,b)=>a.sort_order-b.sort_order).map((m)=>m.module_type)})),
+    visits:rows.visits.map((v)=>({id:v.id,clientId:v.client_id,summary:v.summary ?? "",date:localParts(v.created_at,"UTC").date})),
+  };
+}
+
+export async function loadLockedStudioRows(supabase: SupabaseClient, studioId: string) {
+  const specs = [
+    ["clients","id, first_name, last_name, created_at"],
+    ["appointments","id, client_id, service_id, starts_at, timezone, status, readiness_status"],
+    ["client_experiences","id, client_id, experience_modules, created_at"],
+    ["client_experience_responses","client_experience_id, module_type, payload"],
+    ["beauty_packs","id, name, service_category"],
+    ["beauty_pack_modules","beauty_pack_id, module_type, sort_order"],
+    ["visit_memories","id, client_id, summary, created_at"],
+    ["services","id, category"],
+  ];
+  const results = await Promise.all(specs.map(async ([table,columns]) => {
+    const records: unknown[] = [];
+    // Supabase's default row cap is 1000: page explicitly and keep a stable order.
+    for (let page=0; page<100; page++) {
+      let query=supabase.from(table).select(columns).eq("studio_id",studioId).order("id").range(page*500,page*500+499);
+      if (table === "beauty_packs") query=query.eq("active",true);
+      const {data,error}=await query;
+      if(error) throw new Error(`Unable to restore Studio ${table}.`);
+      records.push(...(data ?? []));
+      if(!data || data.length<500) return records;
+    }
+    throw new Error("Studio restoration exceeded the supported record limit.");
+  }));
+  const [clients,appointments,experiences,responses,packs,modules,visits,services]=results;
+  return adaptLockedStudioRows({clients,appointments,experiences,responses,packs,modules,visits,services} as LockedStudioRows);
+}
