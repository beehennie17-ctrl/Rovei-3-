+import { test, expect, type Page } from "@playwright/test";
+// Browser regression with explicit Paddle/API fixtures. Real Sandbox checkout
+// and Hookdeck delivery are separate launch gates; this suite proves neither.
+const transactionId=`txn_${"a".repeat(26)}`;
+async function fixture(page:Page, active=false) {
+  let cancelled=false,checkoutCalls=0,cancelCalls=0;
+  await page.route("https://cdn.paddle.com/**",route=>route.fulfill({contentType:"application/javascript",body:`window.Paddle={Environment:{set(){}},Initialize(o){window.fixtureCallback=o.eventCallback},Checkout:{open(o){document.querySelector('.rovei-payment-frame').innerHTML='<div aria-label="Mock Paddle frame">Mock secure payment frame — no payment collected</div>';window.fixtureCallback({name:'checkout.loaded',data:{transaction_id:o.transactionId,currency_code:'ZAR',totals:{subtotal:2400,tax:360,total:2760,discount:0,balance:2760},recurring_totals:{total:2760}}})},close(){}}};`}));
+  await page.route("**/api/billing/subscription",route=>route.fulfill({json:{status:cancelled?"cancelled":active?"active":"inactive",email:"studio@example.invalid",billing:active?"annual":null,currentPeriodEnd:active?"2099-11-14T00:00:00Z":null,accessActive:active&&!cancelled}}));
+  await page.route("**/api/billing/checkout",route=>{checkoutCalls++;return route.fulfill({json:{transactionId}})});
+  await page.route("**/api/billing/manage",route=>{cancelCalls++;cancelled=true;return route.fulfill({json:{state:"paddle_confirmed"}})});
+  return {checkoutCalls:()=>checkoutCalls,cancelCalls:()=>cancelCalls};
+}
+test("inline checkout opens one server transaction and uses Paddle localized tax and totals",async({page})=>{
+ const calls=await fixture(page);await page.goto('/activate/checkout');
+ await page.getByRole('button',{name:'Continue to subscribe'}).click();
+ await expect(page.getByLabel('Mock Paddle frame')).toBeVisible();
+ await expect(page.getByText('Total due today').locator('..')).toContainText('ZAR 2,760.00');
+ await expect(page.getByRole('button',{name:'Annual',exact:false})).toBeDisabled();
+ expect(calls.checkoutCalls()).toBe(1);
+});
+test("immediate cancellation requires both confirmations and waits for server-confirmed lockout",async({page})=>{
+ const calls=await fixture(page,true);await page.goto('/activate/checkout');
+ await page.getByRole('button',{name:'Cancel subscription',exact:true}).click();expect(calls.cancelCalls()).toBe(0);
+ await page.getByRole('button',{name:'Continue cancellation'}).click();expect(calls.cancelCalls()).toBe(0);
+ await page.getByRole('button',{name:'Confirm immediate cancellation'}).click();
+ await expect(page.getByText('Your subscription has ended.',{exact:false})).toBeVisible();expect(calls.cancelCalls()).toBe(1);
+});
+test("checkout failure stays visible and never claims paid access",async({page})=>{
+ await fixture(page);await page.route('**/api/billing/checkout',route=>route.fulfill({status:503,json:{message:'Fixture checkout unavailable'}}));
+ await page.goto('/activate/checkout');await page.getByRole('button',{name:'Continue to subscribe'}).click();
+ await expect(page.getByRole('alert')).toContainText('Fixture checkout unavailable');await expect(page.getByRole('link',{name:'Continue to Studio'})).toHaveCount(0);
+});
+for(const width of [320,390,1440]) test(`checkout fits a ${width}px viewport`,async({page})=>{
+ await page.setViewportSize({width,height:1000});await fixture(page);await page.goto('/activate/checkout');
+ await expect(page.getByRole('button',{name:'Continue to subscribe'})).toBeVisible();
+ expect(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth)).toBe(true);
+});
