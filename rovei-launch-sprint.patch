diff --git a/tests/checkout-events.test.mjs b/tests/checkout-events.test.mjs
new file mode 100644
index 0000000..0e3c24c
--- /dev/null
+++ b/tests/checkout-events.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { readCheckoutTotals, validateRoveiPrices, paddleSubscriptionEvents } from '../lib/billing/checkout-events.ts';
+import { hasActiveSubscription } from '../lib/backend/subscription-access.ts';
+
+test('checkout uses Paddle localized totals and credit balance without inventing VAT', () => {
+  const totals = readCheckoutTotals({currency_code:'ZAR',totals:{subtotal:2400,tax:360,total:2760,discount:0,balance:2500},recurring_totals:{total:2760}});
+  assert.deepEqual(totals,{currency:'ZAR',subtotal:2400,tax:360,total:2500,discount:0,recurringTotal:2760});
+  assert.equal(readCheckoutTotals({currency_code:'JPY',totals:{subtotal:15000,tax:0,total:15000,discount:0}}).total,15000);
+});
+test('checkout rejects incomplete, negative and nonfinite financial payloads', () => {
+  const data = {currency_code:'USD',totals:{subtotal:129,tax:0,total:129,discount:0}};
+  for(const broken of [null,{}, {...data,currency_code:'bad'}, {...data,totals:{...data.totals,tax:NaN}}, {...data,totals:{...data.totals,total:-1}}, {...data,totals:{...data.totals,balance:Infinity}}]) assert.equal(readCheckoutTotals(broken),null);
+});
+const price = (interval,amount) => ({data:{product_id:'pro_fixture',status:'active',trial_period:null,billing_cycle:{interval,frequency:1},unit_price:{currency_code:'USD',amount}}});
+test('catalog requires matching product, correct recurring amounts, no trial and active prices', () => {
+  const month=price('month','12900'),year=price('year','129000');
+  assert.equal(validateRoveiPrices(month,year),true);
+  for(const changed of [{...year.data,product_id:'different'},{...year.data,status:'archived'},{...year.data,trial_period:{interval:'day',frequency:7}},{...year.data,unit_price:{currency_code:'USD',amount:'12900'}}]) assert.equal(validateRoveiPrices(month,{data:changed}),false);
+});
+test('missing or invalid period never grants paid access', () => {
+  assert.equal(hasActiveSubscription('active',null),false);
+  assert.equal(hasActiveSubscription('active','not-a-date'),false);
+  assert.equal(hasActiveSubscription('trialing','not-a-date'),false);
+});
+test('payment-failure, pause and recovery subscription events are handled',()=>{
