new file mode 100644
index 0000000..f61b67b
--- /dev/null
+++ b/app/api/auth/account/route.ts
@@ -0,0 +1,21 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+import { backendErrorResponse, BackendError, readJsonBody, requireSameOrigin } from "@/lib/backend/errors";
+import { requireAuthenticatedUser } from "@/lib/backend/studio-context";
+
+const accountSchema=z.union([
+  z.object({firstName:z.string().trim().min(1).max(80)}).strict(),
+  z.object({email:z.string().email().max(254)}).strict(),
+]);
+export async function POST(request: Request) {
+  try {
+    requireSameOrigin(request);
+    const body=accountSchema.parse(await readJsonBody(request));
+    const {supabase}=await requireAuthenticatedUser();
+    const update="email" in body ? {email:body.email} : {data:{first_name:body.firstName,full_name:body.firstName}};
+    const {error}=await supabase.auth.updateUser(update);
+    if(error) throw new BackendError(502,"account_update_failed","Your account changes could not be saved. Please try again.");
+    // Never mark a requested email change as confirmed locally.
+    return NextResponse.json({updated:true,emailConfirmationRequired:"email" in body},{headers:{"Cache-Control":"no-store"}});
+  } catch(error) {return backendErrorResponse(error);}
+}
