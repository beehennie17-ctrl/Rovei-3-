+const bridge=await readFile(new URL('../public/rovei-studio-persistence.js',import.meta.url),'utf8');
+const KEY='rovei:full-process-preview-v3';
+function createShell(fetch, appPage="new-pack") {
+ const initial={version:3,screen:'app',appPage,productTourCompleted:true,studio:{exists:true,name:'Fixture Studio',timezone:'Africa/Johannesburg',services:['lashes'],theme:'wine',customPrimary:'#941651',modules:['consultation']},account:{firstName:'Owner',email:'owner@example.invalid',terms:true},beautyPacks:[],clients:[],visits:[],settings:{subscriptionStatus:'active',availability:{timezone:'Africa/Johannesburg'}},signupDraft:{password:''},billing:'monthly',packDraft:{name:'',service:'',modules:[]}};
+ const dom=new JSDOM(renderLockedShellDocument(html,initial,null),{url:'https://rovei.example.invalid/',runScripts:'outside-only',pretendToBeVisual:true});
+ const {window}=dom;window.scrollTo=()=>{};window.fetch=fetch;window.AbortSignal=AbortSignal;window.structuredClone=structuredClone;
+ for(const script of window.document.querySelectorAll('script:not([src])'))window.eval(script.textContent);
+ window.eval(bridge);return dom;
+}
+const wait=()=>new Promise(resolve=>setTimeout(resolve,30));
+function fillPack(window) {
+ const document=window.document;
+ document.getElementById('packName').value='Fixture Pack';document.getElementById('packService').value='lashes';
+ document.getElementById('packName').dispatchEvent(new window.Event('input',{bubbles:true}));
+ document.querySelector('[data-pack-module="consultation"]').click();
+}
+test('approved pack form saves remotely once and updates the existing shell only after success',async()=>{
+ let resolveSave,calls=0,payload;
+ const dom=createShell(async(url,options)=>{calls++;assert.equal(url,'/api/beauty-packs');payload=JSON.parse(options.body);return new Promise(resolve=>{resolveSave=resolve;});});
+ try {
+  fillPack(dom.window);dom.window.document.getElementById('saveBeautyPack').click();
+  assert.equal(calls,1);assert.equal(JSON.parse(dom.window.localStorage.getItem(KEY)).beautyPacks.length,0);
+  assert.deepEqual(payload,{name:'Fixture Pack',service:'lashes',modules:['consultation']});
+  resolveSave({ok:true,status:201,json:async()=>({pack:{id:'server-pack-id',...payload}})});await wait();
+  const state=JSON.parse(dom.window.localStorage.getItem(KEY));assert.equal(state.beautyPacks[0].id,'server-pack-id');assert.equal(state.appPage,'packs');
+  assert.match(dom.window.document.querySelector('.toast').textContent,/saved to your Studio/);
+  assert.equal(dom.window.document.getElementById('packForm'),null);
