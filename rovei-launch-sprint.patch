diff --git a/public/rovei-studio-persistence.js b/public/rovei-studio-persistence.js
new file mode 100644
index 0000000..6c07d27
--- /dev/null
+++ b/public/rovei-studio-persistence.js
@@ -0,0 +1,131 @@
+(() => {
+  "use strict";
+  const KEY = "rovei:full-process-preview-v3";
+  let busy = false;
+  let accountEdit = null;
+  let confirmAction = null;
+  let savedStudio = null;
+  function state() { try { return JSON.parse(localStorage.getItem(KEY) || "null"); } catch { return null; } }
+  function notify(message) {
+    document.querySelector(".toast")?.remove();
+    const toast=document.createElement("div"); toast.className="toast";toast.setAttribute("role","status");toast.textContent=message;
+    document.body.appendChild(toast);setTimeout(()=>toast.remove(),5000);
+  }
+  function restore(next) {
+    localStorage.setItem(KEY,JSON.stringify(next));
+    window.dispatchEvent(new StorageEvent("storage",{key:KEY,newValue:JSON.stringify(next),storageArea:localStorage}));
+    if(next.appPage==="packs") document.querySelector('[data-nav="packs"]')?.click();
+  }
+  async function request(path,body) {
+    const response=await fetch(path,{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify(body),signal:AbortSignal.timeout(20000)});
+    const data=await response.json().catch(()=>null);
+    if(!response.ok) {
+      if(response.status===401) { window.location.replace("/login"); throw new Error("Your session ended. Please sign in again."); }
+      if(response.status===402) { window.location.replace("/activate/checkout"); throw new Error("An active subscription is required."); }
+      throw new Error(data?.message || "Changes could not be saved. Please retry.");
+    }
+    return data;
+  }
+  async function savePack() {
+    const current=state();
+    const name=document.getElementById("packName")?.value.trim();
+    const service=document.getElementById("packService")?.value;
+    const modules=current?.packDraft?.modules;
+    if(!name || !service || !modules?.length) { notify("Add a name, service and at least one module.");return; }
+    const result=await request("/api/beauty-packs",{name,service,modules});
+    if(typeof result?.pack?.id!=="string") throw new Error("The saved Beauty Pack could not be verified.");
+    const next=state();next.beautyPacks=[...(next.beautyPacks||[]),result.pack];next.packDraft=null;next.appPage="packs";
+    restore(next);notify("Beauty Pack saved to your Studio.");
+  }
+  async function saveStudio(next) {
+    const studio=next.studio;
+    const preferences=next.settings||{};
+    const availability=preferences.availability?.days && preferences.availability?.start && preferences.availability?.end ? preferences.availability : undefined;
+    const notifications=["newSubmission","intakeComplete","appointmentReminder","cancellation"].every(key=>typeof preferences.notifications?.[key]==="boolean") ? preferences.notifications : undefined;
+    const response=await fetch("/api/studio",{method:"PUT",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({studioName:studio.name,services:studio.services,theme:studio.theme,customPrimary:studio.customPrimary,experienceSelections:studio.modules,timezone:studio.timezone||"UTC",availability,notifications}),signal:AbortSignal.timeout(20000)});
+    const data=await response.json().catch(()=>null);
+    if(!response.ok || data?.saved!==true) throw new Error(data?.message || "Your Studio changes could not be saved.");
+    savedStudio=structuredClone(studio);
+    restore({...state(),studio:next.studio,settings:next.settings});notify("Studio saved.");
+  }
+  function capture(event) {
+    const target=event.target instanceof Element ? event.target.closest("#saveBeautyPack,[data-edit-service],[data-edit-theme],[data-edit-module],#applyRec,#editHex,#saveAvailability,#settingsEditSave,#settingsConfirmDo,[data-notification]") : null;
+    if(!target || state()?.screen!=="app" || (target.id==="settingsConfirmDo" && (confirmAction!=="logout" || target.textContent.trim()!=="Log out"))) return;
+    if(event.type==="click" && (target.id==="editHex" || target.dataset.notification)) return;
+    event.preventDefault();event.stopImmediatePropagation();event.stopPropagation();
+    if(busy) return;
+    busy=true;target.disabled=true;
+    const next=state();
+    let action;
+    if(target.id==="settingsEditSave") action=saveAccount;
+    else if(target.id==="settingsConfirmDo") {
+      if(confirmAction!=="logout") {busy=false;target.disabled=false;return;}
+      action=async()=>{await request("/api/auth/signout",{});localStorage.removeItem(KEY);window.location.replace("/");};
+    }
+    else if(target.id==="saveBeautyPack") action=savePack;
+    else {
+      for(const [attribute,property] of [["editService","services"],["editModule","modules"]]) {
+        const id=target.dataset[attribute];if(!id) continue;
+        const values=next.studio[property];
+        if(values.includes(id)&&values.length===1) { notify("Keep at least one selected.");busy=false;target.disabled=false;return; }
+        next.studio[property]=values.includes(id)?values.filter(v=>v!==id):[...values,id];
+      }
+      if(target.dataset.notification) next.settings.notifications={...next.settings.notifications,[target.dataset.notification]:target.checked};
+      if(target.dataset.editTheme) next.studio.theme=target.dataset.editTheme;
+      if(target.id==="editHex") {
+        const value=target.value.trim();
+        if(!/^#[0-9a-fA-F]{6}$/.test(value)) { notify("Use a six-digit hex colour.");busy=false;target.disabled=false;return; }
+        next.studio.customPrimary=value.toUpperCase();
+      }
+      if(target.id==="applyRec") {
+        const rules={consultation:["lashes","brows","nails","makeup","facials","other"],preferences:["lashes","brows","nails","makeup","facials","other"],inspiration:["lashes","brows","nails","makeup"],consent:["lashes","brows","nails","facials"],prep:["lashes","brows","makeup","facials"],"current-photos":["lashes","brows","makeup","facials"]};
+        next.studio.modules=Object.keys(rules).filter(module=>rules[module].some(service=>next.studio.services.includes(service)));
+      }
+      if(target.id==="saveAvailability") {
+        next.settings.availability={...next.settings.availability,start:document.getElementById("availabilityStart").value,end:document.getElementById("availabilityEnd").value,buffer:document.getElementById("availabilityBuffer").value,timezone:document.getElementById("availabilityTimezone").value};
+        next.studio.timezone=next.settings.availability.timezone;
+      }
+      action=()=>saveStudio(next);
+    }
+    void action().catch(error=>notify(error.message||"Changes could not be saved.")).finally(()=>{busy=false;target.disabled=false;});
+  }
+  async function saveAccount() {
+    let body;
+    if(document.getElementById("settingsNewPassword")) {
+      const password=document.getElementById("settingsNewPassword").value;
+      if(password.length<8 || password!==document.getElementById("settingsConfirmPassword").value) throw new Error("Use at least 8 characters and matching passwords.");
+      body={password};await request("/api/auth/password",body);
+      document.getElementById("settingsNewPassword").value="";document.getElementById("settingsConfirmPassword").value="";
+    } else {
+      const value=document.getElementById("settingsEditValue").value.trim();
+      body=accountEdit==="email" ? {email:value} : {firstName:value};
+      const result=await request("/api/auth/account",body);
+      if(result.emailConfirmationRequired) {notify("Check your email to confirm the address change.");document.getElementById("modalRoot").replaceChildren();return;}
+      const next=state();next.account.firstName=value;restore(next);
+    }
+    confirmAction=null;document.getElementById("modalRoot").replaceChildren();notify("Account changes saved.");
+  }
+  document.addEventListener("click",event=>{
+    if(state()?.screen!=="app")return;
+    const target=event.target instanceof Element ? event.target.closest("#settingsEditName,#settingsEditEmail,#settingsLogout,#settingsDeleteAccount,#settingsConfirmKeep") : null;
+    if(!target)return;
+    if(target.id==="settingsEditName")accountEdit="name";
+    if(target.id==="settingsEditEmail")accountEdit="email";
+    if(target.id==="settingsLogout")confirmAction="logout";
+    if(target.id==="settingsConfirmKeep")confirmAction=null;
+    if(target.id==="settingsDeleteAccount") {event.preventDefault();event.stopImmediatePropagation();notify("Account deletion requires an approved support request. Your records have been retained.");}
+  },true);
+  document.addEventListener("focusout",event=>{
+    if(event.target?.id!=="editStudioName" || state()?.screen!=="app" || event.target.value.trim().length<2 || busy)return;
+    const next=state();next.studio.name=event.target.value.trim();busy=true;
+    void saveStudio(next).catch(error=>{if(savedStudio)restore({...state(),studio:savedStudio});notify(error.message);}).finally(()=>{busy=false;});
+  },true);
+  savedStudio=state()?.screen==="app" ? structuredClone(state().studio) : null;
+  document.addEventListener("click",capture,true);
+  document.addEventListener("change",capture,true);
+  document.addEventListener("submit",event=>{
+    if(event.target?.id!=="packForm"||state()?.screen!=="app") return;
+    event.preventDefault();event.stopImmediatePropagation();
+    if(busy)return;busy=true;void savePack().catch(error=>notify(error.message)).finally(()=>{busy=false;});
+  },true);
+})();
diff --git a/supabase/migrations/20261014155715_launch_billing_hardening.sql b/supabase/migrations/20261014155715_launch_billing_hardening.sql
new file mode 100644
index 0000000..b443ff7
--- /dev/null
+++ b/supabase/migrations/20261014155715_launch_billing_hardening.sql
@@ -0,0 +1,208 @@
+begin;
+
+-- Apply the missing subscription-access migration before this migration.
+create or replace function public.is_studio_subscription_active(target_studio_id uuid)
+returns boolean language sql stable security definer set search_path = '' as $$
+  select auth.uid() is not null
+    and public.is_studio_member(target_studio_id)
+    and exists (select 1 from public.subscriptions s where s.studio_id = target_studio_id
+      and s.status in ('active', 'trialing') and s.current_period_end > pg_catalog.now());
+$$;
+revoke all on function public.is_studio_subscription_active(uuid) from public, anon;
+grant execute on function public.is_studio_subscription_active(uuid) to authenticated;
+
+alter function public.set_updated_at() set search_path = '';
+revoke all on function public.handle_new_user() from public, anon, authenticated;
+revoke all on function public.add_studio_owner_membership() from public, anon, authenticated;
+revoke all on function public.is_studio_member(uuid) from public, anon;
+revoke all on function public.is_studio_owner(uuid) from public, anon;
+grant execute on function public.is_studio_member(uuid) to authenticated;
+grant execute on function public.is_studio_owner(uuid) to authenticated;
+-- Deliberately no browser policies for Paddle's internal reservation/event tables.
+grant select, insert, update, delete on public.paddle_webhook_events, public.paddle_checkout_attempts to service_role;
+
+create or replace function public.apply_paddle_subscription_event(
+  p_event_id text,
+  p_event_type text,
+  p_occurred_at timestamptz,
+  p_studio_id uuid,
+  p_user_id uuid,
+  p_subscription_id text,
+  p_customer_id text,
+  p_price_id text,
+  p_status text,
+  p_current_period_start timestamptz,
+  p_current_period_end timestamptz,
+  p_scheduled_cancel_at timestamptz
+)
+returns boolean
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  inserted_event_count integer;
+  existing_subscription public.subscriptions%rowtype;
+begin
+  if p_event_type not in (
+    'subscription.created',
+    'subscription.updated',
+    'subscription.canceled',
+    'subscription.activated',
+    'subscription.trialing',
+    'subscription.past_due',
+    'subscription.paused',
+    'subscription.resumed'
+  ) then
+    raise exception 'Unsupported Paddle event type';
+  end if;
+
+  if p_status not in (
+    'active',
+    'trialing',
+    'past_due',
+    'paused',
+    'cancelled'
+  ) then
+    raise exception 'Unsupported Paddle subscription status';
+  end if;
+
+  if not exists (
+    select 1
+    from public.studio_members as member
+    join public.studios as studio
+      on studio.id = member.studio_id
+    where member.studio_id = p_studio_id
+      and member.user_id = p_user_id
+      and member.role = 'owner'
+      and studio.owner_user_id = p_user_id
+  ) then
+    raise exception 'Paddle account does not match a Studio owner';
+  end if;
+
+  -- Serialize even when the Studio has no subscription row yet.
+  perform 1 from public.studios where id = p_studio_id for update;
+
+  insert into public.paddle_webhook_events (
+    event_id,
+    event_type,
+    occurred_at
+  )
+  values (
+    p_event_id,
+    p_event_type,
+    p_occurred_at
+  )
+  on conflict (event_id) do nothing;
+
+  get diagnostics inserted_event_count = row_count;
+  if inserted_event_count = 0 then
+    return false;
+  end if;
+
+  select *
+  into existing_subscription
+  from public.subscriptions
+  where studio_id = p_studio_id
+  for update;
+
+  if found then
+    -- A terminated Paddle subscription can never be resurrected by a late event.
+    if existing_subscription.provider_subscription_id = p_subscription_id
+       and existing_subscription.status = 'cancelled'
+       and p_status <> 'cancelled' then
+      return false;
+    end if;
+    if existing_subscription.provider_subscription_id is not null
+       and existing_subscription.provider_subscription_id <> p_subscription_id
+       and existing_subscription.status <> 'cancelled' then
+      raise exception 'Studio already has a different Paddle subscription';
+    end if;
+
+    if existing_subscription.last_event_at is not null
+       and (
+         p_occurred_at < existing_subscription.last_event_at
+         or (
+           p_occurred_at = existing_subscription.last_event_at
+           and existing_subscription.last_event_id is not null
+           and p_event_id collate "C" <= existing_subscription.last_event_id collate "C"
+         )
+       ) then
+      return false;
+    end if;
+  end if;
+
+  insert into public.subscriptions (
+    studio_id,
+    provider,
+    provider_customer_id,
+    provider_subscription_id,
+    price_id,
+    status,
+    current_period_start,
+    current_period_end,
+    scheduled_cancel_at,
+    last_event_at,
+    last_event_id
+  )
+  values (
+    p_studio_id,
+    'paddle',
+    p_customer_id,
+    p_subscription_id,
+    p_price_id,
+    p_status,
+    p_current_period_start,
+    p_current_period_end,
+    p_scheduled_cancel_at,
+    p_occurred_at,
+    p_event_id
+  )
+  on conflict (studio_id) do update
+  set
+    provider_customer_id = excluded.provider_customer_id,
+    provider_subscription_id = excluded.provider_subscription_id,
+    price_id = excluded.price_id,
+    status = excluded.status,
+    current_period_start = excluded.current_period_start,
+    current_period_end = excluded.current_period_end,
+    scheduled_cancel_at = excluded.scheduled_cancel_at,
+    last_event_at = excluded.last_event_at,
+    last_event_id = excluded.last_event_id
+  where (
+      public.subscriptions.provider_subscription_id is null
+      or public.subscriptions.provider_subscription_id = excluded.provider_subscription_id
+      or public.subscriptions.status = 'cancelled'
+    )
+    and (
+      public.subscriptions.last_event_at is null
+      or excluded.last_event_at > public.subscriptions.last_event_at
+      or (
+        excluded.last_event_at = public.subscriptions.last_event_at
+        and (
+          public.subscriptions.last_event_id is null
+          or excluded.last_event_id collate "C" > public.subscriptions.last_event_id collate "C"
+        )
+      )
+    );
+
+  get diagnostics inserted_event_count = row_count;
+  if inserted_event_count = 0 then
+    return false;
+  end if;
+
+  if p_status <> 'cancelled' then
+    delete from public.paddle_checkout_attempts
+    where studio_id = p_studio_id
+      and (
+        transaction_id is not null
+        or lease_expires_at <= pg_catalog.now()
+      );
+  end if;
+
+  return true;
+end;
+$$;
+
+
+commit;
diff --git a/supabase/migrations/20261014160018_atomic_studio_and_pack_saves.sql b/supabase/migrations/20261014160018_atomic_studio_and_pack_saves.sql
