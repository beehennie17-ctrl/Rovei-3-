+export type CheckoutTotals = {
+  currency: string;
+  subtotal: number;
+  tax: number;
+  total: number;
+  discount: number;
+  recurringTotal: number | null;
+};
+
+function record(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? value as Record<string, unknown> : null;
+}
+
+// Paddle.js event amounts are in major currency units. Never substitute USD
+// catalog prices for a localized total or infer a customer's tax rate.
+export function readCheckoutTotals(value: unknown): CheckoutTotals | null {
+  const data = record(value);
+  const totals = record(data?.totals);
+  const recurring = record(data?.recurring_totals);
+  if (!data || !totals || typeof data.currency_code !== "string" ||
+      !/^[A-Z]{3}$/.test(data.currency_code)) return null;
+  for (const field of ["subtotal", "tax", "total", "discount"]) {
+    if (typeof totals[field] !== "number" || !Number.isFinite(totals[field]) ||
+        (totals[field] as number) < 0) return null;
+  }
+  const due = totals.balance ?? totals.total;
+  if (typeof due !== "number" || !Number.isFinite(due) || due < 0) return null;
+  const renewal = recurring?.total;
+  return {
+    currency: data.currency_code,
+    subtotal: totals.subtotal as number,
+    tax: totals.tax as number,
+    total: due,
+    discount: totals.discount as number,
+    recurringTotal: typeof renewal === "number" && Number.isFinite(renewal) && renewal >= 0
+      ? renewal : null,
+  };
+}
+
+export function formatCheckoutAmount(amount: number, currency: string) {
+  return new Intl.NumberFormat("en", { style: "currency", currency }).format(amount);
+}
+
+export function validateRoveiPrices(monthly: unknown, annual: unknown) {
+  const month = record(record(monthly)?.data);
+  const year = record(record(annual)?.data);
+  if (!month || !year || typeof month.product_id !== "string" ||
+      month.product_id !== year.product_id) return false;
+  return [[month, "month", "12900"], [year, "year", "129000"]].every(([raw, interval, amount]) => {
+    const price = raw as Record<string, unknown>;
+    const cycle = record(price.billing_cycle);
+    const unit = record(price.unit_price);
+    return price.status === "active" && price.trial_period === null &&
+      cycle?.interval === interval && cycle.frequency === 1 &&
+      unit?.currency_code === "USD" && unit.amount === amount;
+  });
+}
+
+export const paddleSubscriptionEvents = [
+  "subscription.created", "subscription.updated", "subscription.canceled",
+  "subscription.activated", "subscription.trialing", "subscription.past_due",
+  "subscription.paused", "subscription.resumed",
+] as const;
